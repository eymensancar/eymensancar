   "kim": "anlatici"
  },
  {
   "text": "I left engineering school in March.",
   "nefes": 0.15,
   "mark": null,
   "kim": "anlatici"
  },
  {
   "text": "I sat down for an exam.",
   "nefes": 0.15,
