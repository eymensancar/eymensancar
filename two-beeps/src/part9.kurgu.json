 "sentences": [
  {
   "text": "Two hundred people walked out of a tower today.",
   "nefes": 0.1,
   "mark": null,
   "kim": "anlatici"
  },
  {
   "text": "Almost nobody knew the whole reason.",
   "nefes": 0.3,
   "mark": null,
   "kim": "anlatici"
  },
  {
   "text": "It took six weeks.",
   "nefes": 0.1,
   "mark": null,
   "kim": "anlatici"
  },
  {
   "text": "Not us.",
   "nefes": 0.1,
   "mark": null,
   "kim": "anlatici"
  },
  {
   "text": "Specialists, from three cities.",
   "nefes": 0.1,
   "mark": null,
   "kim": "anlatici"
  },
  {
   "text": "Our job was small: clear the street, and wait behind the line.",
   "nefes": 0.3,
   "mark": null,
   "kim": "anlatici"
  },
  {
   "text": "The night before, I did not open the game.",
   "nefes": 0.1,
   "mark": null,
   "kim": "anlatici"
  },
  {
   "text": "I did not need practice.",
   "nefes": 0.1,
   "mark": null,
   "kim": "anlatici"
  },
  {
   "text": "I needed sleep.",
   "nefes": 0.3,
   "mark": null,
   "kim": "anlatici"
  },
  {
   "text": "At noon, forty floors sat down into their own dust.",
   "nefes": 0.15,
   "mark": "fall",
   "kim": "anlatici"
  },
  {
   "text": "Slowly.",
   "nefes": 0.3,
   "mark": null,
   "kim": "anlatici"
  },
  {
   "text": "Exactly where the engineers wanted.",
   "nefes": 0.1,
   "mark": null,
   "kim": "anlatici"
  },
  {
   "text": "Nobody got a scratch.",
   "nefes": 0.4,
   "mark": null,
   "kim": "anlatici"
  },
  {
   "text": "Mr. Hale watched from beside Daisy.",
   "nefes": 0.1,
   "mark": null,
   "kim": "anlatici"
  },
  {
   "text": "He took off his hat.",
   "nefes": 0.1,
   "mark": null,
   "kim": "anlatici"
  },
  {
   "text": "Daisy stayed silent.",
   "nefes": 0.15,
   "mark": "silent",
   "kim": "anlatici"
  },
  {
   "text": "For once.",
   "nefes": 0.4,
   "mark": null,
   "kim": "anlatici"
  },
  {
   "text": "Nine buildings.",
   "nefes": 0.1,
   "mark": null,
   "kim": "anlatici"
  },
  {
   "text": "Nine lines in black ink.",
   "nefes": 0.1,
   "mark": null,
   "kim": "anlatici"
  },
  {
   "text": "Done.",
   "nefes": 0.4,
   "mark": null,
   "kim": "anlatici"
  },
  {
   "text": "That night I held the list up to the lamp.",
   "nefes": 0.1,
   "mark": null,
   "kim": "anlatici"
  },
  {
   "text": "The blue ink was fresh.",
   "nefes": 0.4,
   "mark": "ink",
   "kim": "anlatici"
  },
  {
   "text": "Grandpa scratched that line out this year.",
   "nefes": 0.1,
   "mark": null,
   "kim": "anlatici"
  },
  {
   "text": "With his own pen.",
   "nefes": 0.3,
   "mark": null,
   "kim": "anlatici"
  },
  {
   "text": "Under it, I could finally read an address.",
   "nefes": 0.6,
   "mark": "reveal",
   "kim": "anlatici"
  },
  {
   "text": "I knew that address.",
   "nefes": 0.15,
   "mark": null,
   "kim": "anlatici"
  },
  {
   "text": "I have known it my whole life.",
   "nefes": 0,
   "mark": "end",
   "kim": "anlatici"
  }
